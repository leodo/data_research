# 派生产物：全部由构建脚本生成（data/ 约 700MB、11295 个逐股缓存，不入库）
data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# 运行状态 / 日志 / 进程
*.log
*.pid
last_update.json
logs/

# 测试 / 诊断产物（tests/smoke.py 本身入库，这些是运行产物）
.coverage
coverage.xml
htmlcov/
.playwright/
test-results/
playwright-report/

# 本地密钥与环境变量（切勿入库）
.env
.env.*
*.pem

# 旧版备份：只排除根目录；archive/ 内的历史快照仍纳入版本控制
/*.bak*
*.orig
*.rej

# 本地助手数据（会话记忆，非项目代码）
.workbuddy/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
*~
Thumbs.db
.DS_Store
desktop.ini
