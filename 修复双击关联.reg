Windows Registry Editor Version 5.00

; Reset user-level .bat/.cmd overrides back to Windows defaults.
; Double-click this file and confirm import if double-clicking a .bat file
; opens an "Choose an app" picker instead of running it.

[-HKEY_CURRENT_USER\Software\Classes\.bat]
[-HKEY_CURRENT_USER\Software\Classes\.cmd]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.bat\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.cmd\UserChoice]
